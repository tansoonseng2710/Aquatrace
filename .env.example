# ---- Security -------------------------------------------------------------
# Protects write endpoints used by people (HPLC upload, training, compounds, surveys).
API_KEY=replace-with-a-long-random-string
# Sensor nodes: comma-separated device_id:key pairs. Each node sends its key as X-API-Key.
DEVICE_KEYS=BOAT-01:replace-with-device-key
# Restrict to your dashboard's origin in production.
CORS_ORIGINS=*

# ---- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Set automatically by docker-compose; for a bare-metal install use e.g.
# DATABASE_URL=postgresql+psycopg://aquatrace:PASSWORD@localhost:5432/aquatrace
# DATABASE_URL=sqlite:///./aquatrace.db

# ---- Screening and anomaly detection -------------------------------------
# compound used for dashboard status and alerts
TARGET_COMPOUND=PCM
# |z| at which a reading counts as an unusual pattern
Z_THRESHOLD=3.0
# readings of memory in the rolling baseline
BASELINE_WINDOW=72
# minutes of normal readings that close an event
EVENT_GAP_MIN=20

# ---- HPLC <-> sensor matching --------------------------------------------
MATCH_WINDOW_MIN=15
MATCH_DIST_M=300

# ---- Integrations (optional) ---------------------------------------------
# Slack / Teams / generic webhook for "possible contamination" alerts
ALERT_WEBHOOK_URL=
# Open-Meteo rainfall context attached to each event (free, no key)
ENABLE_WEATHER=1
# OpenStreetMap: basemap tiles, Nominatim place names, Overpass facility search.
# OSM usage policy asks for an identifying contact; put your email here.
ENABLE_OSM=1
OSM_CONTACT=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_ATTRIBUTION=© OpenStreetMap contributors
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# MQTT (docker-compose sets MQTT_HOST=mqtt). To also store readings from demo phones on a public
# broker, set MQTT_HOST=broker.emqx.io and MQTT_TOPIC=aquatrace/demo/<FLEET CODE>/+/readings
MQTT_TOPIC=aquatrace/+/readings
MQTT_USER=
MQTT_PASS=
